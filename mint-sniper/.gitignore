/target
/ui/node_modules
/ui/dist
__pycache__/
*.pyc
config.toml
.env
.sniper-token
.testnet-keys/
audit.log

# identity (step 10) — same treatment as .sniper-token/config.toml above.
# identity.db holds hashed/encrypted secrets, not plaintext, but the file
# itself is still never meant to leave this machine (session rows alone
# are enough to hijack an admin session if the DB leaked). The -wal/-shm
# siblings are SQLite's WAL-mode journal files; they can contain the same
# data as the main file mid-transaction and must never be committed either.
identity.db
identity.db-wal
identity.db-shm
.session-key

# STEP 27 — run-benchmark.sh's auto-discovered "last redeployed benchmark
# token" state file (deploy/lib/resolve_benchmark_address.sh). Purely
# operator-VPS runtime state (which testnet contract benchmark-token.sh
# last redeployed), never something to commit — same treatment as every
# other *.backup/runtime file in deploy/ already excluded below.
deploy/.benchmark-token-address
